[alias]
    bd = branch --delete
    br = !git --no-pager branch -vv
    ca = commit --amend
    ch = checkout
    cm = commit
    cp = cherry-pick
    ct = !git --no-pager shortlog --summary --numbered --email
    df = diff --patch-with-stat
    ds = df --staged
    dp = difftool --tool=diffpdf *.pdf
    lg = log --graph --stat --date=auto:human --decorate=full
    nb = checkout -b
    rb = checkout -m
    ra = rebase --abort
    rc = rebase --continue
    ri = rebase --interactive
    ss = status -b

[blame]
    coloring = highlightRecent

[branch]
    sort = -committerdate

[core]
    editor = vim
    pager = less -+FSX

[color]
    status = auto

[column]
    ui = auto

[commit]
    verbose = true

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true

[difftool]
    prompt = false

[difftool "diffpdf"]
    cmd = diff-pdf --view \"$LOCAL\" \"$REMOTE\"

[fetch]
    all = true
    prune = true
    pruneTags = true

[grep]
    column = true
    fallbackToNoIndex = true
    lineNumber = true

[help]
    autocorrect = prompt

[init]
    defaultBranch = "master"

[merge]
    tool = vimdiff
    conflictstyle = zdiff3

[mergetool]
    prompt = false

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[rebase]
    missingCommitsCheck = error
    updateRefs = true

[rerere]
    autoupdate = true
    enabled = true

[status]
    short = true
    showStash = true

[tag]
    sort = version:refname

[user]
    email = gzmbnn@gmail.com
    name = Gustavo Zambonin

[url "https://"]
	insteadOf = git://
